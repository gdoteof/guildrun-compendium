{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "guildrun-compendium",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": { "directory": "public", "binding": "ASSETS" },
  // guildrun.gd0t.com is the public name. workers.dev stays ON deliberately:
  // every companion binary shipped so far (<= v0.3.0) and collect.py hardcode
  // the workers.dev host as DEFAULT_SERVER, so retiring it would strand them.
  "workers_dev": true,
  "routes": [
    { "pattern": "guildrun.gd0t.com", "custom_domain": true }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "guildrun", "database_id": "57c725a8-5b7b-4e42-bc50-29ea3d2b26b6" }
  ],
  "kv_namespaces": [
    // RAW_LOGS is legacy: raw storage moved to R2; binding retained so the
    // KV -> R2 migration endpoint stays runnable, remove once KV is emptied
    { "binding": "RAW_LOGS", "id": "a65ba24d742249ef9de58e1c61f27b58" },
    { "binding": "RATE_LIMIT", "id": "6addfc924636476f830fa429d6fb01b1" }
  ],
  "r2_buckets": [
    { "binding": "RAW_R2", "bucket_name": "guildrun-logs" }
  ],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": { "MAX_FILES": "64", "MAX_FILE_BYTES": "16000000" },
  "observability": { "enabled": true }
}
